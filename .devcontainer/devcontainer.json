{
  "name": "Dostar",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/dotnet:2": {
      "version": "10.0.200"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    },
    "ghcr.io/devcontainers/features/azure-cli:1": {},
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "onCreateCommand": "npm install -g pnpm",
  "postCreateCommand": "find . -name obj -type d -not -path '*/.git/*' -exec rm -rf {} + 2>/dev/null; find . -name bin -type d -not -path '*/.git/*' -exec rm -rf {} + 2>/dev/null; az bicep install && dotnet tool install -g dotnet-ef && docker compose up -d && dotnet restore && cd frontend && pnpm install",
  "postStartCommand": "docker compose up -d",
  "remoteEnv": {
    "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}"
  },
  "forwardPorts": [
    5000,
    5173,
    5432
  ],
  "portsAttributes": {
    "5000": {
      "label": "API (Dostar.Api)",
      "onAutoForward": "notify"
    },
    "5173": {
      "label": "Frontend (Vite)",
      "onAutoForward": "openBrowser"
    },
    "5432": {
      "label": "PostgreSQL",
      "onAutoForward": "silent"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-azuretools.vscode-bicep",
        "anthropic.claude-code",
        "humao.rest-client"
      ],
      "settings": {
        "editor.formatOnSave": true
      }
    }
  }
}
