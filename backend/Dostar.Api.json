          "title"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          }
        }
      },
      "TodoDto": {
        "required": [
          "id",
          "title",
          "isCompleted",
          "createdAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "isCompleted": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "UpdateTodoRequest": {
        "required": [
          "title",
          "isComplete"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "isComplete": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Todos"
    }
  ]
