# Copy this file to .env.local for local development (gitignored)

# URL of the backend API (Vite dev server proxies are not used — this must be the full origin)
VITE_API_BASE_URL=http://localhost:5000

# Azure Entra ID app registration client ID (from docs/deploy-setup.md section 3)
VITE_AZURE_CLIENT_ID=<your-api-app-registration-client-id>

# Azure tenant ID (az account show --query tenantId -o tsv)
VITE_AZURE_TENANT_ID=<your-azure-tenant-id>
