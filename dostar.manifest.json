{
  "schemaVersion": "1.0.0",
  "tokens": {
    "pascalCase": "Dostar",
    "lowerCase": "dostar",
    "githubOwner": "piers-sinclair",
    "licenseHolder": "Piers Sinclair",
    "licenseYear": "2025"
  },
  "protectedStrings": [
    "piers-sinclair/Dostar.Cli",
    "Dostar.Cli",
    "`dostar`",
    "dostar new-project",
    "dostar add-module",
    "dostar remove-module",
    "dostar add-feature",
    "dostar remove-feature",
    "dostar:feature:",
    "<code className=\"text-xs\">dostar</code>"
  ],
  "tokenFiles": [
    "backend/Dostar.Api/Dostar.Api.csproj",
    "backend/Dostar.Api/Program.cs",
    "frontend/src/routes/__root.tsx",
    "CHANGELOG.md",
    ".release-please-manifest.json",
    "LICENSE"
  ],
  "bicepParameters": [
    "workload",
    "env",
    "region",
    "instance",
    "location",
    "staticWebAppLocation",
    "postgresAdminUsername",
    "postgresAdminPassword",
    "containerCpu",
    "containerMemory",
    "containerMinReplicas",
    "containerMaxReplicas",
    "postgresSkuName",
    "postgresStorageSizeGB",
    "postgresEnableHa",
    "alertEmailAddress",
    "containerImage"
  ],
  "moduleStructure": {
    "baseDir": "backend/Modules",
    "contractsProjectSuffix": ".Contracts",
    "implementationProjectSuffix": ".Implementation",
    "unitTestsSuffix": ".UnitTests",
    "integrationTestsSuffix": ".IntegrationTests",
    "entryPoint": {
      "programCsPath": "backend/{prefix}.Api/Program.cs",
      "moduleArrayPattern": "IModule[] modules =\n["
    }
  },
  "featureStructure": {
    "featuresDir": "frontend/src/features",
    "routesDir": "frontend/src/routes",
    "rootRouteFile": "frontend/src/routes/__root.tsx",
    "sentinelCommentPrefix": "dostar:feature:",
    "navImportSource": "@tanstack/react-router"
  }
}
